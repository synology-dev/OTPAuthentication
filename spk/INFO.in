package="OTPManager"
version="@VERSION@"
displayname="OTP Manager"
description="Self-hosted TOTP/2FA authenticator vault for DSM users with PIN lock, sharing, and encrypted backup. Data stays on your NAS."
arch="@ARCH@"
maintainer="KhoaZero123"
