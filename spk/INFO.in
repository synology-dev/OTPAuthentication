support_url="https://github.com/synology-dev/OTPManager/issues"
os_min_ver="7.0-40337"
dsmuidir="ui"
dsmappname="SYNO.SDS.OTPManager.Application"
thirdparty="yes"
silent_install="yes"
silent_upgrade="yes"
silent_uninstall="no"
startable="yes"
reloadui="yes"
install_reboot="no"
ctl_stop="yes"
ctl_uninstall="yes"