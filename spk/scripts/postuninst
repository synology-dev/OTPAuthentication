#!/bin/sh
set -eu
# Synology uninstall wizard key `wipe_data` is exported into the script environment.
WIPE="${wipe_data:-${OTPAUTHENTICATION_WIPE_DATA:-}}"
case "${WIPE}" in
  true|TRUE|1|yes|YES)
    rm -rf /volume1/@appdata/OTPAuthentication 2>/dev/null || true
    rm -rf /var/packages/OTPAuthentication/var 2>/dev/null || true
    ;;
esac
exit 0
